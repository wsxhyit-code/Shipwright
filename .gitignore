# ---------------------------------------------------------------------------
# ★ 最重要的一条：.mewcode 下的**本地配置**绝不能进仓库
#
# `.mewcode/config.yaml` 里有 provider 的 api_key（明文）。它一旦被推上去
# 就等于把密钥公开了 —— 而且 git 历史里的东西删不干净，只能换 key。
#
# 所以这里按"白名单"来：整个 .mewcode 都忽略，只放行 skills 和示例配置。
# ---------------------------------------------------------------------------
.mewcode/*
!.mewcode/skills/
!.mewcode/config.yaml.example

# 运行时会话数据
.mewcode/sessions/
.mewcode/session/
.mewcode/file-history/
.mewcode/history
.mewcode/memories.md
.mewcode/debug.log
.mewcode/pr/

# 本地覆盖层（个人机器上的 permissions / hooks 覆盖）
*.local.yaml

# ---------------------------------------------------------------------------
# 测试与评测的临时目录
# ---------------------------------------------------------------------------
.eval-tmp/
.pytest-tmp/
.pytest_cache/
pytest-cache-files-*/

# ---------------------------------------------------------------------------
# 手工备份（本项目没有 git 仓库时用来兜底的目录）
# ---------------------------------------------------------------------------
.revert-backup/
.revert-*/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# ---------------------------------------------------------------------------
# 与 Shipwright 无关的杂物（代码里零引用）
#
#  · dsh-phone.ps1 —— DSH Web GUI 暴露到手机的脚本，里面还写着一条本机绝对路径，
#    不该进这个仓库
#  · a2a_demo/     —— A2A 协议的示例卡片，本仓库代码从不读它
#
# 想把它们一起提交的话，把对应行注释掉、并 `git add -f` 即可
# （已暂存的文件不受 .gitignore 影响，得先用 `git rm --cached` 摘出来）。
# ---------------------------------------------------------------------------
dsh-phone.ps1
a2a_demo/

# ---------------------------------------------------------------------------
# 编辑器 / 操作系统
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
