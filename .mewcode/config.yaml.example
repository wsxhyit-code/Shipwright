# 复制成 .mewcode/config.yaml 后填上你自己的值。
#
# ⚠️ `config.yaml` 已在 .gitignore 里 —— **不要把填好的那份提交上去**。
#    填好之后如果已经 commit 过，光删文件不够：git 历史里还在，
#    唯一的补救是去 provider 后台把这个 key 作废重发。

providers:
  # 每个 provider 的名字随便起，用来在日志里区分。
  - name: anthropic-official
    protocol: anthropic                    # anthropic / openai / openai-compat
    base_url: https://api.anthropic.com
    # 也可以用环境变量：api_key: "${ANTHROPIC_API_KEY}"
    # （config.py 的 resolve_env_vars 会展开 ${VAR}）
    api_key: "${ANTHROPIC_API_KEY}"
    model: claude-sonnet-4-5
    thinking: false                        # 是否开启 extended thinking

  # 国内可用、便宜得多的替代（本次开发用的就是这条链路）：
  # - name: deepseek
  #   protocol: anthropic                  # DeepSeek 提供了 Anthropic 兼容端点
  #   base_url: https://api.deepseek.com/anthropic
  #   api_key: "${DEEPSEEK_API_KEY}"
  #   model: deepseek-v4-pro
  #   thinking: true

# 权限模式：default / acceptEdits / plan / bypassPermissions / custom / dontAsk
permission_mode: default

# MCP server。category 决定权限语义：
#   read    → DEFAULT 模式下 allow，且允许并发（只读工具不会互相干扰）
#   write   → ask
#   command → ask（默认，最保守）
mcp_servers:
  - name: context7
    command: npx
    args: ["-y", "@upstash/context7-mcp"]
    category: read

# ---------------------------------------------------------------------------
# toolset —— 把「提 PR」和「运维数据源」接进 agent
#
# ⚠️ 不写这一段的话，内置只有 6 个工具（ReadFile / WriteFile / EditFile /
#    Bash / Glob / Grep），CreatePR 和运维工具**一个都装不进来**。
