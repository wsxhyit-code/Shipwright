#       token_env: "LOKI_READONLY_TOKEN"             # 从环境变量读，配置里不落密钥
#       # 建议用**只读** token：运维动作的裁判延迟很长，回滚/重启错了就是二次故障
#     - kind: prometheus
#       base_url: "https://prom.internal"
#     - kind: alertmanager
#       base_url: "https://am.internal"
