# 复制成 .mewcode/config.yaml 后填上你自己的值。
#
# ⚠️ `config.yaml` 已在 .gitignore 里 —— **不要把填好的那份提交上去**。
#    填好之后如果已经 commit 过，光删文件不够：git 历史里还在，
#    唯一的补救是去 provider 后台把这个 key 作废重发。

providers:
  # 每个 provider 的名字随便起，用来在日志里区分。
  - name: anthropic-official
    protocol: anthropic                    # anthropic / openai / openai-compat
    base_url: https://api.anthropic.com
    # 也可以用环境变量：api_key: "${ANTHROPIC_API_KEY}"
    # （config.py 的 resolve_env_vars 会展开 ${VAR}）
    api_key: "${ANTHROPIC_API_KEY}"
    model: claude-sonnet-4-5
    thinking: false                        # 是否开启 extended thinking

  # 国内可用、便宜得多的替代（本次开发用的就是这条链路）：
  # - name: deepseek
  #   protocol: anthropic                  # DeepSeek 提供了 Anthropic 兼容端点
  #   base_url: https://api.deepseek.com/anthropic
  #   api_key: "${DEEPSEEK_API_KEY}"
  #   model: deepseek-v4-pro
  #   thinking: true

# 权限模式：default / acceptEdits / plan / bypassPermissions / custom / dontAsk
permission_mode: default

# MCP server。category 决定权限语义：
#   read    → DEFAULT 模式下 allow，且允许并发（只读工具不会互相干扰）
#   write   → ask
#   command → ask（默认，最保守）
mcp_servers:
  - name: context7
    command: npx
    args: ["-y", "@upstash/context7-mcp"]
    category: read

# ---------------------------------------------------------------------------
# toolset —— 把「提 PR」和「运维数据源」接进 agent
#
# ⚠️ 不写这一段的话，内置只有 6 个工具（ReadFile / WriteFile / EditFile /
#    Bash / Glob / Grep），CreatePR 和运维工具**一个都装不进来**。
# ---------------------------------------------------------------------------
# toolset:
#   create_pr:
#     enabled: true
#     verify_command: "python -m pytest tests/ -q"   # 必填；没配会在启动时报错
#     artifacts_dir: ".mewcode/pr"
#     base_ref: "main"
#     require_independent: true                      # 必须配独立验证者，否则拒绝
#     timeout: 900
#
#     # 交付模式 —— agent 自己走到哪一步
#     mode: patch        # patch（只出补丁）| push（推 agent/* 分支）| pr（再开 PR）
#     remote: origin
#     api_base: ""       # 留空 = https://api.github.com；自建实例填 https://<host>/api/v3
#
#   ops:
#     - kind: loki
#       base_url: "https://loki.internal"
#       token_env: "LOKI_READONLY_TOKEN"             # 从环境变量读，配置里不落密钥
#       # 建议用**只读** token：运维动作的裁判延迟很长，回滚/重启错了就是二次故障
#     - kind: prometheus
#       base_url: "https://prom.internal"
#     - kind: alertmanager
#       base_url: "https://am.internal"
#       token_env: "AM_TOKEN"
#     # 部署 / 工单没有通用标准，需要自己写适配器；不接就保持不写
#     # （调用时会明确报「未接入」，而不是静默返回空）
#
#   # --- 企业知识库：内部规范 / SOP / 架构说明 ---------------------------------
#   #
#   # 没有它，agent 只能凭**通用最佳实践**写代码 —— 而通用最佳实践和内部规范
#   # 经常是冲突的，它自己察觉不到。配了之后它动手前会先查一次。
#   knowledge:
#     kind: local                # local（扫本地 markdown，开箱可用）| http | mock
#     extra_dirs: ["docs/standards", "docs/adr"]
#     include_user_dir: true     # 同时扫 ~/.mewcode/knowledge/
#
#     # 文档放在 <工作目录>/.mewcode/knowledge/**/*.md（目录约定同 skills/agents）。
#     # 标题取一级标题，标签写一行 `tags: 规范, 数据库`。
#     #
#     # 接内部检索 API 时改成：
#     # kind: http
#     # base_url: "https://kb.internal/api"
#     # path: "/search"
#     # query_param: "q"
#     # token_env: "KB_READONLY_TOKEN"
#     # read_path: "/docs/{id}"    # 不配就只能检索、读不了全文
#     # mapping:                   # 响应形状和默认不一样时映射一下
#     #   response_path: "hits.hits"
#     #   id_field: "_id"
#     #   title_field: "_source.title"
#
#   # --- 代码规范校验：把「符合内部标准」变成硬关卡 -----------------------------
#   #
#   # 光往 system prompt 里塞规范是**软约束**（模型可能没读、读漏、写完就忘）。
#   # 这里把规范做成**可执行的检查命令**：退出码非 0 就拒绝交付。
#   # 它排在所有验证之前 —— 通常就是 lint/grep，最便宜。
#   #
#   # create_pr:
#   #   standards:
#   #     - name: no-print-in-business-code
#   #       command: 'grep -rn "print(" src/ && exit 1 || exit 0'
#   #       hint: 业务代码用 logging，不要用 print
#   #     - name: ruff-lint
#   #       command: "ruff check ."
#   #     # 也可以只写一个字符串（名字和命令都用它）
#   #     # - "python -m mypy src/"
#
#   # --- 环境管理：让 agent 自己能起测试环境 ------------------------------------
#   #
#   # 方向二要「agent 自己起测试环境验证」。但**不能给它 docker 权限** ——
#   # 给了就等于挂 docker.sock，等于交出宿主 root（业界最常见的沙箱穿透）。
#   #
#   # 折中方案：agent 能起环境，但**只能执行平台给定的那几条命令**。
#   # stop / reset 是破坏性动作，各自有开关，默认关。
#   #
#   # environment:
#   #   start:  "bash /app/scripts/up-test-env.sh"
#   #   status: "bash /app/scripts/env-status.sh"
#   #   # stop:  "bash /app/scripts/down-test-env.sh"
#   #   # reset: "bash /app/scripts/reset-test-db.sh"
#   #   allow_stop: false      # 默认关；打开会停掉环境
#   #   allow_reset: false     # 默认关；打开会重置数据（可能影响别人）
#   #   timeout: 600
#   #   settle_seconds: 5      # 起完等一会儿再认为 ready
#
#   # --- 插件：第三方装包即接入私有工具 -----------------------------------------
#   #
#   # 打开后，任何声明了 `mewcode.tools` entry point 的已安装包都会自动注册工具：
#   #
#   #   # 第三方包的 pyproject.toml
#   #   [project.entry-points."mewcode.tools"]
#   #   acme = "acme_mewcode:register"
#   #
#   #   # acme_mewcode/__init__.py
#   #   def register(registry):
#   #       registry.register(QueryAcmeOrders())
#   #       return ["QueryAcmeOrders"]
#   #
#   # 坏插件不会拖垮 agent（记为失败并继续），但**一定会出现在能力清单里** ——
#   # 「悄悄少了一批工具」是最坏的结果。
#   plugins: false
